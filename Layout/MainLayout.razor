@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

<div class="top-left">
    <button class="menu-button" @ref="buttonRef" aria-label="Menü"></button>
</div>

<div class="menu-overlay" style="display:none" @ref="overlayRef">
    <nav class="menu-panel">
        <NavLink class="menu-link" href="" data-route="" @onclick="CloseMenuNow">Startseite</NavLink>
        <NavLink class="menu-link" href="verlauf" data-route="verlauf" @onclick="CloseMenuNow">Verlauf</NavLink>
    </nav>
</div>

<div class="page">
    @Body
</div>

@code {
    private ElementReference buttonRef;
    private ElementReference overlayRef;
    private DotNetObjectReference<MainLayout>? dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("dragMenuInterop.init", buttonRef, overlayRef, dotNetRef);
        }
    }

    [JSInvokable]
    public void NavigateTo(string route)
    {
        Navigation.NavigateTo(route);
    }

    private async Task CloseMenuNow()
    {
        await JS.InvokeVoidAsync("dragMenuInterop.close", overlayRef);
    }

    public async ValueTask DisposeAsync()
    {
        dotNetRef?.Dispose();
    }
}