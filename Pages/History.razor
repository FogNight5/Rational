@page "/verlauf"
@inject Rational.Interfaces.ILocalStorageService LocalStorageService
@using Rational.Models
@using System.Linq
@using System.Text.Json

<div class="centerlized main history-container">
    <h1>Verlauf</h1>

    @if (_task is null)
    {
        <p>Keine Einträge gefunden.</p>
    }
    else
    {
        <div class="history-list-wrapper">
            <ol class="dash-list">
                @foreach (var ts in _task.CompletedAt.OrderByDescending(d => d))
                {
                    <li>@ts.ToLocalTime().ToString("g")</li>
                }
            </ol>
        </div>

        @if (_task.CompletedAt.Count > 0)
        {
            <div class="export-section">
                <button class="btn btn-secondary" @onclick="CopyExportToClipboard">
                    @(_copyFeedback == "" ? "Exportieren & Kopieren" : _copyFeedback)
                </button>
            </div>
        }
    }
</div>

@code {
    private DailyTask? _task;
    private string _copyFeedback = "";

    private const string DailyTaskKey = "dailyTask";

    protected override async Task OnInitializedAsync()
    {
        _task = await LocalStorageService.LoadAsync<DailyTask>(DailyTaskKey);

        if (_task is null) // Code duplication #1
        {
            _task = new DailyTask { Name = "Tägliche Aufgabe" };
            await LocalStorageService.SaveAsync(DailyTaskKey, _task);
        }
    }

    private async Task CopyExportToClipboard()
    {
        if (_task?.CompletedAt.Count == 0)
            return;

        var exportData = _task!.CompletedAt
            .OrderBy(d => d)
            .Select(ts => new { Timestamp = ts.ToString("O") })
            .ToList();

        string json = JsonSerializer.Serialize(exportData);

        await JS.InvokeVoidAsync("navigator.clipboard.writeText", json);

        _copyFeedback = "✓ Kopiert!";
        StateHasChanged();

        await Task.Delay(2000);
        _copyFeedback = "";
        StateHasChanged();
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;
}
